# AI 项目记忆目录（本地追溯，不纳入版本库）
.MemoryForAI/

# 本地敏感信息（GitHub Token / API Key 等，绝不提交）
.secrets/

# Cursor：保留 rules/skills 进仓库，其余本地忽略
.cursor/*
!.cursor/rules/
!.cursor/rules/**
!.cursor/skills/
!.cursor/skills/**

# 本地敏感配置
.env

# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
*.egg
.pytest_cache/

# 虚拟环境
.venv/
venv/
env/

# IDE
.idea/

# 日志与报告产物
logs/
reports/

# 构建产物（保留 build/README.md）
build/*
!build/README.md

# 本地运行态（RAG 库 / Skill 缓存 / 文档缓存）
.ifrit/
api_docs/cache/

