# 复制为 .env 并填写本地/敏感配置（.env 不纳入 Git）
# cp .env.example .env

# ---------- LLM（OpenAI 兼容） ----------
# 公网/网关必填；本地无鉴权服务可留空
OPENAI_API_KEY=
# 可选：个人临时覆盖 config/settings/ai.ini 中的 base_url
OPENAI_BASE_URL=
# 可选：个人临时覆盖 config/settings/ai.ini 中的 model
OPENAI_MODEL=

# ---------- 被测 API（可选个人 override） ----------
# 默认使用 config/settings/env_config.ini 团队环境地址
IFRIT_BASE_URL=

# ---------- 钉钉机器人 ----------
DINGTALK_ACCESS_TOKEN=
DINGTALK_KEYWORD=通知

# ---------- 数据库（敏感凭证） ----------
DB_USER=
DB_PASSWORD=
